int main() {
    int n;
    cin >> n;

    int a[n];

    for(int i = 0; i < n; i++) {
        cin >> a[i];
    }

    int dp[n];

    dp[0] = 0;
    dp[1] = abs(a[1] - a[0]);

    for(int i = 2; i < n; i++) {

        int x = dp[i-1] + abs(a[i] - a[i-1]);

        int y = dp[i-2] + abs(a[i] - a[i-2]);

        dp[i] = min(x, y);
    }

    cout << dp[n-1] << endl;

    return 0;
}
