#include <bits/stdc++.h>
using namespace std;

int main()
{
    int start[] = {1, 3, 0, 5, 8, 5};
    int finish[] = {2, 4, 6, 7, 9, 9};

    int n = 6;

    // Sort according to finish time
    for (int i = 0; i < n; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (finish[i] > finish[j])
            {
                swap(finish[i], finish[j]);
                swap(start[i], start[j]);
            }
        }
    }

    cout << "Selected Activities: ";

    int last = 0;
    int count = 1;

    cout << "1 ";

    for (int i = 1; i < n; i++)
    {
        if (start[i] >= finish[last])
        {
            cout << i + 1 << " ";
            last = i;
            count++;
        }
    }

    cout << "\nTotal Activities = " << count;

    return 0;
}

