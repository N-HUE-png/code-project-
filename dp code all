#include <bits/stdc++.h>
using namespace std;

int dp[1000];

int coinChange(int coin[], int n, int amount)
{
    if (amount == 0)
        return 0;

    if (amount < 0)
        return 9999;

    if (dp[amount] != -1)
        return dp[amount];

    int ans = 9999;

    for (int i = 0; i < n; i++)
    {
        int x = coinChange(coin, n, amount - coin[i]);

        ans = min(ans, x + 1);
    }

    return dp[amount] = ans;
}

