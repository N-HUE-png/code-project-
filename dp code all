#include <bits/stdc++.h>
using namespace std;

int coinChange(int coin[], int n, int amount)
{
    if (amount == 0)
        return 0;

    if (amount < 0)
        return 9999;

    int ans = 9999;

    for (int i = 0; i < n; i++)
    {
        int x = coinChange(coin, n, amount - coin[i]);

        ans = min(ans, x + 1);
    }

    return ans;
}

int main()
{
    int coin[] = {1, 3, 4};
    int n = 3;
    int amount = 6;

    int ans = coinChange(coin, n, amount);

    if (ans == 9999)
        cout << -1;
    else
        cout << ans;

    return 0;
}
