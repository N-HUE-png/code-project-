#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    int k;
    cin >> k;

    int h[n];

    for(int i = 0; i < n; i++) {
        cin >> h[i];
    }

    int dp[n];

    dp[0] = 0;

    for(int i = 1; i < n; i++) {
        dp[i] = INT_MAX;

        for(int j = 1; j <= k; j++) {
            if(i - j >= 0) {

                int cost = dp[i-j] + abs(h[i-j] - h[i]);

                dp[i] = min(dp[i], cost);
            }
        }
    }

    cout << dp[n-1] << endl;

    return 0;
}
