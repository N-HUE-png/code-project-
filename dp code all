fractional knackpack

#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n = 3;
    float weight[] = {10, 20, 30};
    float profit[] = {60, 100, 120};
    float capacity = 50;

    float ratio[3];

    for (int i = 0; i < n; i++)
    {
        ratio[i] = profit[i] / weight[i];
    }

    // Sort according to ratio
    for (int i = 0; i < n; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (ratio[i] < ratio[j])
            {
                swap(ratio[i], ratio[j]);
                swap(weight[i], weight[j]);
                swap(profit[i], profit[j]);
            }
        }
    }

    float total = 0;

    for (int i = 0; i < n; i++)
    {
        if (weight[i] <= capacity)
        {
            total += profit[i];
            capacity -= weight[i];
        }
        else
        {
            total += ratio[i] * capacity;
            break;
        }
    }

    cout << "Maximum Profit = " << total;

    return 0;
}
