#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, x;
    cin >> n >> x;

    int p[n], g[n];

    for(int i = 0; i < n; i++) {
        cin >> p[i];
    }

    for(int i = 0; i < n; i++) {
        cin >> g[i];
    }

    int dp[x+1] = {};

    for(int i = 0; i < n; i++) {
        for(int j = x; j >= p[i]; j--) {
            dp[j] = max(dp[j], dp[j-p[i]] + g[i]);
        }
    }

    cout << dp[x] << endl;

    return 0;
}
