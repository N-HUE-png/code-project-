1)  insertation sort

#include <iostream>
using namespace std;

int main()
{
    int n;
    cin >> n;

    int a[100];

    for(int i = 1; i <= n; i++)
    {
        cin >> a[i];
    }

    a[0] = -9999;   // Sentinel

    for(int k = 2; k <= n; k++)
    {
        int temp = a[k];
        int ptr = k - 1;

        while(temp < a[ptr])
        {
            a[ptr + 1] = a[ptr];
            ptr--;
        }

        a[ptr + 1] = temp;
    }

    for(int i = 1; i <= n; i++)
    {
        cout << a[i] << " ";
    }

    return 0;
}

