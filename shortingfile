2)  selection sort
#include <iostream>
using namespace std;

int main()
{
    int n;
    cin >> n;

    int arr[100];

    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    for(int k = 0; k < n - 1; k++)
    {
        int loc = k;

        for(int j = k + 1; j < n; j++)
        {
            if(arr[j] < arr[loc])
            {
                loc = j;
            }
        }

        int temp = arr[k];
        arr[k] = arr[loc];
        arr[loc] = temp;
    }

    for(int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}




