4)  quick short 
#include <iostream>
#include <vector>
using namespace std;

int partitation(vector<int> &arr, int st, int end)
{
    int idx = st - 1;
    int pivot = arr[end];

    for(int j = st; j < end; j++)
    {
        if(arr[j] <= pivot)
        {
            idx++;
            swap(arr[j], arr[idx]);
        }
    }

    swap(arr[idx + 1], arr[end]);

    return idx + 1;
}

void quickshort(vector<int> &arr, int st, int end)
{
    if(st < end)
    {
        int pessi = partitation(arr, st, end);

        quickshort(arr, st, pessi - 1);
        quickshort(arr, pessi + 1, end);
    }
}

int main()
{
    vector<int> arr = {12, 31, 35, 8, 32, 17};

    quickshort(arr, 0, arr.size() - 1);

    for(int i = 0; i < arr.size(); i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}
